#!/usr/bin/env bash
# Production deploy on the Raspberry Pi — run after git push from your Mac:
#   cd ~/silver-happiness && ./bin/deploy
#
# Refuses to go live if smoke tests or HTTP checks fail; rolls back to previous commit.
set -euo pipefail

DEPLOY_SCRIPT="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
cd "$(dirname "$0")/.."

export RAILS_ENV=production

if [[ -f .env.production ]]; then
  set -a
  # shellcheck disable=SC1091
  source .env.production
  set +a
fi

if [[ -z "${SECRET_KEY_BASE:-}" ]]; then
  echo "ERROR: SECRET_KEY_BASE is not set."
  echo "Create .env.production from .env.production.example and run: bin/rails secret"
  exit 1
fi

# Pull first, then re-exec so this script always runs the latest version of itself.
if [[ "${SILVER_DEPLOY_REEXEC:-}" != "1" ]]; then
  PREVIOUS_SHA="$(git rev-parse HEAD)"
  echo "==> Pull latest code"
  git fetch origin main
  git reset --hard origin/main
  echo "==> Re-running deploy with updated script"
  exec env SILVER_DEPLOY_REEXEC=1 "SILVER_DEPLOY_PREVIOUS_SHA=${PREVIOUS_SHA}" "${DEPLOY_SCRIPT}" "$@"
fi

PREVIOUS_SHA="${SILVER_DEPLOY_PREVIOUS_SHA:-$(git rev-parse HEAD)}"
NEW_SHA="$(git rev-parse HEAD)"
LAST_GOOD_FILE="tmp/last_good_revision"

echo "==> Deploying revision: ${NEW_SHA}"
echo "==> Rollback target:    ${PREVIOUS_SHA}"
if [[ -f "${LAST_GOOD_FILE}" ]]; then
  echo "==> Last good deploy:   $(tr -d '[:space:]' < "${LAST_GOOD_FILE}")"
fi

rollback() {
  echo ""
  echo "==> DEPLOY FAILED — rolling back to ${PREVIOUS_SHA}"
  git reset --hard "${PREVIOUS_SHA}"
  echo "${PREVIOUS_SHA}" > tmp/revision
  bundle install
  bin/rails tmp:clear
  bin/rails assets:precompile
  sudo systemctl restart silver-happiness
  sleep 2
  echo "Rolled back. Check ./bin/doctor and journalctl -u silver-happiness -n 30"
  exit 1
}

wait_for_service() {
  local max_attempts="${1:-30}"
  local attempt=1

  echo "==> Waiting for silver-happiness service"
  while [[ "${attempt}" -le "${max_attempts}" ]]; do
    if systemctl is-active --quiet silver-happiness 2>/dev/null; then
      echo "    service active (attempt ${attempt}/${max_attempts})"
      return 0
    fi
    echo "    waiting for service… (attempt ${attempt}/${max_attempts})"
    sleep 2
    attempt=$((attempt + 1))
  done

  echo "FAILED: silver-happiness never became active"
  systemctl status silver-happiness --no-pager 2>/dev/null || true
  journalctl -u silver-happiness -n 20 --no-pager 2>/dev/null || true
  return 1
}

wait_for_http() {
  local label="$1"
  local url="$2"
  local expect="${3:-200}"
  local max_attempts="${4:-30}"
  local attempt=1
  local code="000"

  echo "==> HTTP check: ${label} (${url})"
  while [[ "${attempt}" -le "${max_attempts}" ]]; do
    code="$(curl -s -o /tmp/deploy_check_body.txt -w '%{http_code}' \
      --connect-timeout 2 --max-time 8 \
      -H 'X-Forwarded-Proto: https' \
      "${url}" 2>/dev/null || echo "000")"

    if [[ "${code}" == "${expect}" ]]; then
      echo "    OK — HTTP ${code} (attempt ${attempt}/${max_attempts})"
      return 0
    fi

    echo "    waiting… HTTP ${code} (attempt ${attempt}/${max_attempts})"
    sleep 2
    attempt=$((attempt + 1))
  done

  echo "FAILED: ${label} never returned HTTP ${expect} (last: ${code})"
  head -20 /tmp/deploy_check_body.txt 2>/dev/null || true
  echo ""
  echo "--- recent service logs ---"
  journalctl -u silver-happiness -n 20 --no-pager 2>/dev/null || true
  return 1
}

verify_health_json() {
  echo "==> Health check: /health"
  local body code
  body="$(curl -s --connect-timeout 2 --max-time 8 -H 'X-Forwarded-Proto: https' http://127.0.0.1:3000/health 2>/dev/null || true)"
  code="$(curl -s -o /dev/null -w '%{http_code}' --connect-timeout 2 --max-time 8 -H 'X-Forwarded-Proto: https' http://127.0.0.1:3000/health 2>/dev/null || echo "000")"
  echo "${body}" | head -c 500
  echo ""
  if [[ "${code}" != "200" ]]; then
    echo "FAILED: /health returned HTTP ${code}"
    return 1
  fi
  if echo "${body}" | grep -q '"status":"error"'; then
    echo "FAILED: /health reports errors (see above)"
    return 1
  fi
  return 0
}

echo "==> Install gems"
if ! grep -q "^  ruby$" Gemfile.lock; then
  bundle lock --add-platform ruby
fi
bundle config set --local deployment 'true' 2>/dev/null || true
bundle config set --local without 'development test' 2>/dev/null || true
bundle install

# A migration is the only thing in this script that can touch your logged data,
# so snapshot first. `.backup` is safe to run while the app is serving.
echo "==> Back up database"
mkdir -p storage/backups
BACKUP_FILE="storage/backups/production-$(date +%Y%m%d-%H%M%S).sqlite3"
if ! command -v sqlite3 >/dev/null 2>&1; then
  echo "FAILED: sqlite3 is not installed — refusing to migrate without a backup"
  echo "Install it with: sudo apt-get install -y sqlite3"
  exit 1
fi
if ! sqlite3 storage/production.sqlite3 ".backup ${BACKUP_FILE}"; then
  echo "FAILED: could not back up the database — refusing to migrate"
  exit 1
fi
echo "    saved ${BACKUP_FILE} ($(du -h "${BACKUP_FILE}" | cut -f1))"
# Keep the 20 most recent, and never rotate away the one just written.
ls -1t storage/backups/production-*.sqlite3 \
  | grep -vxF "${BACKUP_FILE}" \
  | tail -n +20 \
  | xargs -r rm -f

echo "==> Migrate database"
if ! bin/rails db:migrate; then
  echo "Migration failed — restoring database and rolling back code"
  cp "${BACKUP_FILE}" storage/production.sqlite3
  rollback
fi

echo "==> Smoke test (before restart)"
if ! bin/rails runner script/production_smoke_test.rb; then
  echo "Smoke test failed — not restarting with broken code"
  rollback
fi

echo "==> Precompile assets"
bin/rails tmp:clear
bin/rails assets:precompile

echo "==> Restart app"
sudo systemctl restart silver-happiness

if ! wait_for_service; then
  rollback
fi

if ! wait_for_http "up" "http://127.0.0.1:3000/up"; then
  rollback
fi

if ! wait_for_http "health" "http://127.0.0.1:3000/health"; then
  rollback
fi
if ! verify_health_json; then
  rollback
fi

if ! wait_for_http "home page" "http://127.0.0.1:3000/"; then
  rollback
fi

RECIPE_PATH="$(bin/rails runner 'r = Recipe.joins(:meal_template).find_by(slug: "chipotle-yogurt-salad") || Recipe.joins(:meal_template).first; print r ? "/recipes/#{r.id}" : ""')"
if [[ -z "${RECIPE_PATH}" ]]; then
  echo "FAILED: no recipe with meal template found — cannot verify recipe pages"
  rollback
fi
if ! wait_for_http "chipotle recipe" "http://127.0.0.1:3000${RECIPE_PATH}"; then
  rollback
fi

mkdir -p tmp
echo "${NEW_SHA}" > tmp/revision
echo "${NEW_SHA}" > "${LAST_GOOD_FILE}"
rm -f tmp/last_error.txt

echo ""
echo "Deploy complete — ${NEW_SHA}"
echo "Status page: https://raspberrypi.tail57e96f.ts.net/status"
