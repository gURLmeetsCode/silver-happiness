#!/usr/bin/env bash
# Quick diagnostics on the Pi when something looks wrong.
set -euo pipefail

cd "$(dirname "$0")/.."

export RAILS_ENV=production
if [[ -f .env.production ]]; then
  set -a
  # shellcheck disable=SC1091
  source .env.production
  set +a
fi

echo "=== Silver Happiness doctor ==="
echo ""

echo "--- systemd ---"
systemctl is-active silver-happiness 2>/dev/null || echo "service not active"
echo ""

echo "--- local HTTP ---"
curl -s -o /dev/null -w "GET /up     → HTTP %{http_code}\n" http://127.0.0.1:3000/up || echo "GET /up     → failed"
curl -s -o /dev/null -w "GET /       → HTTP %{http_code}\n" -H "X-Forwarded-Proto: https" http://127.0.0.1:3000/ || echo "GET /       → failed"
RECIPE_PATH="$(bin/rails runner 'r = Recipe.joins(:meal_template).find_by(slug: "chipotle-yogurt-salad") || Recipe.joins(:meal_template).first; print r ? "/recipes/#{r.id}" : ""' 2>/dev/null || true)"
if [[ -n "${RECIPE_PATH}" ]]; then
  curl -s -o /dev/null -w "GET ${RECIPE_PATH} → HTTP %{http_code}\n" -H "X-Forwarded-Proto: https" "http://127.0.0.1:3000${RECIPE_PATH}" || echo "GET ${RECIPE_PATH} → failed"
fi
echo ""

echo "--- /health ---"
curl -s -H "X-Forwarded-Proto: https" http://127.0.0.1:3000/health 2>/dev/null | head -c 800 || echo "(no response)"
echo ""
echo ""

echo "--- last app error (tmp/last_error.txt) ---"
if [[ -f tmp/last_error.txt ]]; then
  ERROR_AT="$(head -1 tmp/last_error.txt)"
  echo "(logged at ${ERROR_AT} — may be from before the last deploy)"
  tail -n +2 tmp/last_error.txt | tail -14
else
  echo "(none recorded)"
fi
echo ""

echo "--- recent logs ---"
journalctl -u silver-happiness -n 20 --no-pager 2>/dev/null || echo "(journalctl unavailable)"
echo ""

echo "Bookmark on your phone: /status"
echo "Fix deploy:            cd ~/silver-happiness && ./bin/deploy"
