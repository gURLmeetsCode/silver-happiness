<% content_for :title, "Home" %>

<header class="home-hero mb-4 d-flex justify-content-between align-items-start gap-2">
  <div>
    <p class="home-hero-date mb-1"><%= Date.current.strftime("%A, %B %-d") %></p>
    <h1 class="home-hero-greeting mb-0"><%= home_greeting(@goal) %></h1>
  </div>
  <%= link_to journal_path, class: "btn btn-link text-secondary p-1", "aria-label": "Profile and journal" do %>
    <i class="bi bi-person fs-5"></i>
  <% end %>
</header>

<%= render "cut_status", daily_log: @today, goal: @goal, protein_suggestions: @protein_suggestions %>
<%= render "water_quick", daily_log: @today, goal: @goal, return_to: root_path %>

<section class="card home-card mb-3">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-baseline mb-3">
      <h2 class="h6 text-uppercase text-muted mb-0">Weight</h2>
      <% if @goal.life_stage_pregnancy? %>
        <span class="small text-muted">pregnancy · IOM lower path</span>
      <% else %>
        <span class="small text-muted">target <%= @goal.target_weight_kg %> kg</span>
      <% end %>
    </div>

    <%= form_with model: @today, url: daily_log_path(@today), method: :patch, class: "row g-2 align-items-end" do |f| %>
      <%= hidden_field_tag :return_to, root_path %>
      <div class="col">
        <%= f.label :weight_kg, "This morning", class: "form-label small text-muted" %>
        <div class="input-group input-group-lg">
          <%= f.number_field :weight_kg, step: :any, inputmode: "decimal",
                placeholder: "—", class: "form-control", "aria-label": "Weight in kilograms" %>
          <span class="input-group-text">kg</span>
        </div>
      </div>
      <div class="col-auto">
        <%= f.submit "Save", class: "btn btn-primary btn-lg" %>
      </div>
    <% end %>

    <p class="small text-muted mb-0 mt-2"><%= weight_vs_goal_label(@goal, @today.weight_kg) %></p>
  </div>
</section>

<section class="card home-card mb-4">
  <div class="card-body">
    <h2 class="h6 text-uppercase text-muted mb-3">Sleep</h2>

    <%= form_with model: @today, url: daily_log_path(@today), method: :patch do |f| %>
      <%= hidden_field_tag :return_to, root_path %>
      <div class="row g-2">
        <div class="col-6 col-sm-4">
          <%= f.label :bed_time, "Bed", class: "form-label small text-muted" %>
          <%= f.time_field :bed_time, class: "form-control" %>
        </div>
        <div class="col-6 col-sm-4">
          <%= f.label :wake_time, "Wake", class: "form-label small text-muted" %>
          <%= f.time_field :wake_time, class: "form-control" %>
        </div>
        <div class="col-12 col-sm-4">
          <%= f.label :sleep_quality, "Quality", class: "form-label small text-muted" %>
          <%= f.select :sleep_quality, DailyLog::SLEEP_QUALITY_OPTIONS,
                { include_blank: "—" }, class: "form-select" %>
        </div>
      </div>

      <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3">
        <span class="small text-muted"><%= @today.sleep_summary.presence || "Not logged yet" %></span>
        <%= f.submit "Save sleep", class: "btn btn-outline-primary" %>
      </div>
    <% end %>
  </div>
</section>

<%= render "cut_nudges", suggestions: @cut_suggestions, dismissed: @cut_dismissed, recipes: @nudge_recipes %>

<% if @daily_inspo %>
  <section class="card home-card home-inspo mb-4">
    <div class="card-body">
      <div class="d-flex justify-content-between align-items-baseline mb-3">
        <h2 class="h6 text-uppercase text-muted mb-0">Daily inspo</h2>
        <%= link_to "Closet", outfit_photos_path, class: "small text-decoration-none" %>
      </div>

      <div class="home-inspo-stage<%= " home-inspo-stage--pair" if @daily_inspo_alt %>">
        <% if @daily_inspo_alt&.image&.attached? %>
          <div class="home-inspo-polaroid home-inspo-polaroid--peek" aria-hidden="true">
            <%= image_tag url_for(@daily_inspo_alt.image), alt: "", loading: "lazy" %>
          </div>
        <% end %>

        <% if @daily_inspo.image.attached? %>
          <%= link_to outfit_photos_path, class: "home-inspo-polaroid home-inspo-polaroid--feature text-decoration-none" do %>
            <%= image_tag url_for(@daily_inspo.image),
                  alt: @daily_inspo.caption.presence || @daily_inspo.category_label %>
          <% end %>
        <% end %>
      </div>

      <div class="home-inspo-meta mt-3 text-center">
        <span class="badge text-bg-light border"><%= @daily_inspo.category_label %></span>
        <p class="small text-muted mb-0 mt-2">
          Worn <%= @daily_inspo.logged_on.strftime("%b %-d, %Y") %>
        </p>
        <% if @daily_inspo.caption.present? %>
          <p class="mb-0 mt-1"><%= @daily_inspo.caption %></p>
        <% end %>
      </div>
    </div>
  </section>
<% end %>

<h2 class="h6 text-uppercase text-muted mb-2">Log something</h2>
<div class="home-actions mb-3">
  <%= link_to daily_log_path(@today, anchor: "meals"), class: "home-action" do %>
    <i class="bi bi-egg-fried"></i>
    <span class="home-action-label">Meal</span>
    <span class="home-action-hint">Copy yesterday or build</span>
  <% end %>

  <%= link_to daily_log_path(@today, anchor: "water"), class: "home-action" do %>
    <i class="bi bi-cup-straw"></i>
    <span class="home-action-label">Beverage</span>
    <span class="home-action-hint">Coffee, drinks, bottles</span>
  <% end %>

  <%= link_to new_daily_log_strength_session_path(@today, **(@suggested_strength ? { workout_plan_id: @suggested_strength.id } : {})), class: "home-action" do %>
    <i class="bi bi-lightning"></i>
    <span class="home-action-label">Strength</span>
    <span class="home-action-hint"><%= @suggested_strength&.name || "Log a session" %></span>
  <% end %>

  <%= link_to new_outfit_photo_path(category: :feeling_cute), class: "home-action" do %>
    <i class="bi bi-camera"></i>
    <span class="home-action-label">Outfit</span>
    <span class="home-action-hint">Snap how you look</span>
  <% end %>

  <%= link_to journal_path(anchor: "today-check-in"), class: "home-action" do %>
    <i class="bi bi-journal-heart"></i>
    <span class="home-action-label">Check-in</span>
    <span class="home-action-hint">Period, mood, notes</span>
  <% end %>
</div>

<%= link_to new_daily_log_urge_check_in_path(@today, return_to: root_path),
      class: "btn btn-outline-dark w-100 mb-4 py-3" do %>
  <i class="bi bi-pause-circle me-1"></i>
  <strong>I’m about to spiral</strong>
  <span class="d-block small text-muted fw-normal mt-1">Pause 90 seconds before the binge</span>
<% end %>

<div class="d-grid gap-2 d-sm-flex">
  <%= link_to metrics_path, class: "btn btn-dark btn-lg flex-fill" do %>
    <i class="bi bi-graph-up me-1"></i> See my metrics
  <% end %>
  <%= link_to daily_log_path(@today), class: "btn btn-outline-secondary btn-lg flex-fill" do %>
    <i class="bi bi-journal-check me-1"></i> Full day log
  <% end %>
</div>
