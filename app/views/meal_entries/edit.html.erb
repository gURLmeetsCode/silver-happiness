<% content_for :title, "Edit meal" %>

<div class="mb-4">
  <%= link_to "← #{@daily_log.logged_on.strftime('%b %-d')}", @daily_log, class: "text-decoration-none small" %>
</div>

<% if @recipe %>
  <p class="text-muted mb-3">
    From recipe: <%= link_to @recipe.name, recipe_path(@recipe) %>.
    Set servings (e.g. 3 wraps), add extras like jalapeños or Cholula in tbsp, then save.
  </p>
  <%= render "recipes/recipe_meal_form",
        recipe: @recipe,
        daily_log: @daily_log,
        products: @products,
        entry: @entry,
        form_url: daily_log_meal_entry_path(@daily_log, @entry),
        form_method: :patch %>
<% else %>

<h1 class="h3 mb-4">Edit meal</h1>

<%= form_with model: [@daily_log, @entry], class: "row g-3" do |f| %>
  <% if @entry.errors.any? %>
    <div class="col-12 alert alert-danger"><%= @entry.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="col-md-6">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: "form-control", required: true %>
  </div>
  <div class="col-md-6">
    <%= f.label :meal_type, class: "form-label" %>
    <%= f.select :meal_type, MealEntry.meal_types.keys.map { |k| [ k.humanize, k ] }, {}, class: "form-select" %>
  </div>
  <div class="col-6 col-md-3">
    <%= f.label :calories, class: "form-label" %>
    <%= f.number_field :calories, class: "form-control", required: true %>
  </div>
  <div class="col-6 col-md-3">
    <%= f.label :protein_g, "Protein (g)", class: "form-label" %>
    <%= f.number_field :protein_g, step: 0.1, class: "form-control", required: true %>
  </div>
  <div class="col-6 col-md-3">
    <%= f.label :carbs_g, "Carbs (g)", class: "form-label" %>
    <%= f.number_field :carbs_g, step: 0.1, class: "form-control" %>
  </div>
  <div class="col-6 col-md-3">
    <%= f.label :fat_g, "Fat (g)", class: "form-label" %>
    <%= f.number_field :fat_g, step: 0.1, class: "form-control" %>
  </div>
  <div class="col-12">
    <%= f.label :notes, class: "form-label" %>
    <%= f.text_field :notes, class: "form-control" %>
  </div>
  <div class="col-12 d-flex gap-2">
    <%= f.submit "Save changes", class: "btn btn-primary" %>
    <%= link_to "Cancel", @daily_log, class: "btn btn-outline-secondary" %>
  </div>
<% end %>

<% end %>
