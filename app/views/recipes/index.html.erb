<% content_for :title, "Recipes" %>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
  <div>
    <h1 class="h3 mb-1">Recipes</h1>
    <p class="text-muted mb-0">
      Browse and manage what’s on rotation. To log a meal, open
      <%= link_to "Today", today_path(anchor: "meals") %> and build or copy from yesterday.
    </p>
  </div>
  <div class="d-flex flex-wrap gap-2">
    <%= link_to "Add recipe", new_recipe_path, class: "btn btn-primary" %>
    <%= add_product_link(return_to: recipes_path, label: "Add product", css_class: "btn btn-outline-primary") %>
    <%= link_to "Grocery list", grocery_recipes_path, class: "btn btn-success" %>
    <%= link_to "Today’s log", today_path, class: "btn btn-outline-secondary" %>
  </div>
</div>

<div data-controller="list-filter">
  <div class="d-flex flex-wrap gap-2 mb-4 align-items-center">
    <div class="flex-grow-1" style="min-width: 12rem; max-width: 22rem">
      <label class="visually-hidden" for="recipe-search">Search recipes</label>
      <input id="recipe-search" type="search" class="form-control form-control-sm"
             placeholder="Search recipes…"
             data-list-filter-target="input"
             data-action="input->list-filter#filter">
    </div>
    <div class="btn-group flex-wrap" role="group">
      <%= link_to "All", recipes_path(show_archived: params[:show_archived]), class: "btn btn-sm #{params[:filter].blank? ? 'btn-dark' : 'btn-outline-dark'}" %>
      <% Recipe.meal_types.each_key do |type| %>
        <%= link_to Recipe::MEAL_TYPE_LABELS[type] || type.humanize,
              recipes_path(filter: type, show_archived: params[:show_archived]),
              class: "btn btn-sm #{params[:filter] == type ? 'btn-dark' : 'btn-outline-dark'}" %>
      <% end %>
    </div>
    <% if @archived_count.positive? || params[:show_archived] == "1" %>
      <%= link_to params[:show_archived] == "1" ? "Hide archived" : "Show archived",
            recipes_path(filter: params[:filter], show_archived: params[:show_archived] == "1" ? nil : "1"),
            class: "btn btn-sm btn-outline-secondary" %>
    <% end %>
  </div>

  <p class="small text-muted mb-3 d-none" data-list-filter-target="empty">No recipes match that search.</p>

  <% if params[:filter].present? %>
    <div class="row g-3">
      <% @recipes.each do |recipe| %>
        <div class="col-md-6 col-lg-4" data-list-filter-target="card"
             data-search-text="<%= [ recipe.name, recipe.description, recipe.meal_type_label, recipe.macros_label ].compact.join(' ') %>">
          <%= render "recipe_card", recipe: recipe %>
        </div>
      <% end %>
    </div>
  <% else %>
    <% if @regular_meals.any? %>
      <h2 class="h5 mb-2">Meals on rotation</h2>
      <p class="small text-muted mb-3">Plated meals that also drive your grocery list.</p>
      <div class="row g-3 mb-4">
        <% @regular_meals.each do |recipe| %>
          <div class="col-md-6 col-lg-4" data-list-filter-target="card"
               data-search-text="<%= [ recipe.name, recipe.description, recipe.meal_type_label, recipe.macros_label ].compact.join(' ') %>">
            <%= render "recipe_card", recipe: recipe %>
          </div>
        <% end %>
      </div>
    <% end %>

    <% if @batch_trays.any? %>
      <h2 class="h5 mb-2">Batch trays</h2>
      <p class="small text-muted mb-3">Prep once, then log a share in Build a meal (¼, ½, …).</p>
      <div class="row g-3 mb-4">
        <% @batch_trays.each do |recipe| %>
          <div class="col-md-6 col-lg-4" data-list-filter-target="card"
               data-search-text="<%= [ recipe.name, recipe.description, recipe.meal_type_label, recipe.macros_label ].compact.join(' ') %>">
            <%= render "recipe_card", recipe: recipe %>
          </div>
        <% end %>
      </div>
    <% end %>

    <% if @suggested_recipes.any? %>
      <h2 class="h5 mb-2">Extras &amp; swaps</h2>
      <p class="small text-muted mb-3">Saved, but not on the grocery list.</p>
      <div class="row g-3 mb-4">
        <% @suggested_recipes.each do |recipe| %>
          <div class="col-md-6 col-lg-4" data-list-filter-target="card"
               data-search-text="<%= [ recipe.name, recipe.description, recipe.meal_type_label, recipe.macros_label ].compact.join(' ') %>">
            <%= render "recipe_card", recipe: recipe %>
          </div>
        <% end %>
      </div>
    <% end %>

    <% if @tired_recipes.any? %>
      <h2 class="h5 mb-2 text-muted">Tired of these</h2>
      <p class="small text-muted mb-3">Off rotation and grocery — still here if you want them back.</p>
      <div class="row g-3 mb-4">
        <% @tired_recipes.each do |recipe| %>
          <div class="col-md-6 col-lg-4" data-list-filter-target="card"
               data-search-text="<%= [ recipe.name, recipe.description, recipe.meal_type_label, recipe.macros_label ].compact.join(' ') %>">
            <%= render "recipe_card", recipe: recipe %>
          </div>
        <% end %>
      </div>
    <% end %>

    <% if @archived_recipes&.any? %>
      <h2 class="h5 mb-2 text-muted">Archived</h2>
      <div class="row g-3">
        <% @archived_recipes.each do |recipe| %>
          <div class="col-md-6 col-lg-4" data-list-filter-target="card"
               data-search-text="<%= [ recipe.name, recipe.description, recipe.meal_type_label, recipe.macros_label ].compact.join(' ') %>">
            <%= render "recipe_card", recipe: recipe %>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
