<% nutrition = @recipe.nutrition_per_serving %>
<% daily_log = DailyLog.today %>
<% zucchini = Product.find_by(name: "Zucchini") %>
<% puget_oil = Product.find_by(name: "Puget Huile d'olive vierge extra") %>

<div class="card stat-card mb-4 border-primary">
  <div class="card-body">
    <h2 class="h5 mb-2">Log today with adjustments</h2>
    <p class="small text-muted mb-3">
      Base recipe: <%= nutrition[:calories] %> kcal · <%= nutrition[:protein].round(1) %> g protein.
      Add extras or edit numbers before saving.
    </p>

    <%= form_with url: daily_log_meal_entries_path(daily_log), method: :post,
          data: {
            controller: "recipe-log",
            recipe_log_base_calories_value: nutrition[:calories],
            recipe_log_base_protein_value: nutrition[:protein],
            recipe_log_base_carbs_value: nutrition[:carbs] || 0,
            recipe_log_base_fat_value: nutrition[:fat] || 0,
            action: "change->recipe-log#recalculate input->recipe-log#recalculate"
          } do %>
      <%= hidden_field_tag :meal_template_id, @recipe.meal_template.id if @recipe.meal_template.present? %>

      <div class="row g-2 mb-3">
        <div class="col-md-6">
          <%= label_tag "meal_entry[name]", "Meal name", class: "form-label" %>
          <%= text_field_tag "meal_entry[name]", @recipe.name, class: "form-control", required: true %>
        </div>
        <div class="col-md-6">
          <%= label_tag "meal_entry[meal_type]", "Meal type", class: "form-label" %>
          <%= select_tag "meal_entry[meal_type]",
                options_for_select(MealEntry.meal_types.keys.map { |k| [ k.humanize, k ] }, @recipe.meal_type),
                class: "form-select" %>
        </div>
        <div class="col-6 col-md-3">
          <%= label_tag "meal_entry[calories]", "Calories", class: "form-label" %>
          <%= number_field_tag "meal_entry[calories]", nutrition[:calories], class: "form-control", required: true,
                data: { recipe_log_target: "calories", action: "input->recipe-log#recalculate" } %>
        </div>
        <div class="col-6 col-md-3">
          <%= label_tag "meal_entry[protein_g]", "Protein (g)", class: "form-label" %>
          <%= number_field_tag "meal_entry[protein_g]", nutrition[:protein].round(1), step: 0.1, class: "form-control", required: true,
                data: { recipe_log_target: "protein", action: "input->recipe-log#recalculate" } %>
        </div>
        <div class="col-6 col-md-3">
          <%= label_tag "meal_entry[carbs_g]", "Carbs (g)", class: "form-label" %>
          <%= number_field_tag "meal_entry[carbs_g]", nutrition[:carbs]&.round(1), step: 0.1, class: "form-control",
                data: { recipe_log_target: "carbs", action: "input->recipe-log#recalculate" } %>
        </div>
        <div class="col-6 col-md-3">
          <%= label_tag "meal_entry[fat_g]", "Fat (g)", class: "form-label" %>
          <%= number_field_tag "meal_entry[fat_g]", nutrition[:fat]&.round(1), step: 0.1, class: "form-control",
                data: { recipe_log_target: "fat", action: "input->recipe-log#recalculate" } %>
        </div>
        <div class="col-12">
          <%= label_tag "meal_entry[notes]", "Notes", class: "form-label" %>
          <%= text_field_tag "meal_entry[notes]", nil, class: "form-control", placeholder: "e.g. + basil, + ½ zucchini, + 2 tbsp Puget oil",
                data: { recipe_log_target: "notes" } %>
        </div>
      </div>

      <h3 class="h6 text-muted">Add extras (optional)</h3>
      <% [
        [ zucchini, zucchini&.default_serving_g ],
        [ puget_oil, 20 ]
      ].each_with_index do |(product, default_qty), i| %>
        <div class="row g-2 mb-2" data-recipe-log-target="extraRow">
          <div class="col-md-7">
            <select name="extras[<%= i %>][product_id]" class="form-select form-select-sm"
                    data-recipe-log-target="extraProduct" data-action="change->recipe-log#recalculate">
              <option value="">Optional extra…</option>
              <% @products.each do |p| %>
                <option value="<%= p.id %>"
                  data-calories="<%= p.calories_per_100g %>"
                  data-protein="<%= p.protein_per_100g %>"
                  data-carbs="<%= p.carbs_per_100g %>"
                  data-fat="<%= p.fat_per_100g %>"
                  <%= "selected" if product && p.id == product.id %>>
                  <%= p.name %><%= " (#{p.brand})" if p.brand.present? %>
                </option>
              <% end %>
            </select>
          </div>
          <div class="col-md-5">
            <input type="number" name="extras[<%= i %>][quantity_g]" step="0.1" min="0"
                   class="form-control form-control-sm" placeholder="grams"
                   value="<%= default_qty if default_qty %>"
                   data-recipe-log-target="extraQuantity" data-action="input->recipe-log#recalculate">
          </div>
        </div>
      <% end %>
      <% (2..2).each do |i| %>
        <div class="row g-2 mb-2" data-recipe-log-target="extraRow">
          <div class="col-md-7">
            <select name="extras[<%= i %>][product_id]" class="form-select form-select-sm"
                    data-recipe-log-target="extraProduct" data-action="change->recipe-log#recalculate">
              <option value="">Optional extra…</option>
              <% @products.each do |p| %>
                <option value="<%= p.id %>"
                  data-calories="<%= p.calories_per_100g %>"
                  data-protein="<%= p.protein_per_100g %>"
                  data-carbs="<%= p.carbs_per_100g %>"
                  data-fat="<%= p.fat_per_100g %>">
                  <%= p.name %><%= " (#{p.brand})" if p.brand.present? %>
                </option>
              <% end %>
            </select>
          </div>
          <div class="col-md-5">
            <input type="number" name="extras[<%= i %>][quantity_g]" step="0.1" min="0"
                   class="form-control form-control-sm" placeholder="grams"
                   data-recipe-log-target="extraQuantity" data-action="input->recipe-log#recalculate">
          </div>
        </div>
      <% end %>

      <p class="small fw-semibold mb-3" data-recipe-log-target="preview"></p>
      <%= submit_tag "Log this meal today", class: "btn btn-primary" %>
    <% end %>
  </div>
</div>
