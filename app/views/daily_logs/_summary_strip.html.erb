<%# locals: daily_log, goal %>
<% energy = daily_log.energy_estimate %>
<div class="summary-strip mb-3">
  <div class="summary-cell">
    <span class="summary-label">Eaten</span>
    <span class="summary-value"><%= daily_log.total_calories %></span>
    <span class="summary-hint">of ~<%= daily_log.calorie_target %> kcal</span>
  </div>
  <div class="summary-cell">
    <span class="summary-label">Burned</span>
    <span class="summary-value"><%= daily_log.calories_burned %></span>
    <span class="summary-hint">net <%= daily_log.net_calories %> kcal</span>
  </div>
  <div class="summary-cell">
    <span class="summary-label">Protein</span>
    <span class="summary-value"><%= daily_log.total_protein.round(0) %> g</span>
    <span class="summary-hint">
      <% protein_left = daily_log.protein_to_min_g(goal) %>
      <% if protein_left.positive? %>
        <%= protein_left %> g to min
      <% else %>
        goal <%= goal.protein_min_g %>–<%= goal.protein_max_g %> g
      <% end %>
    </span>
  </div>
  <div class="summary-cell">
    <span class="summary-label">Carbs</span>
    <span class="summary-value"><%= daily_log.total_carbs.round(0) %> g</span>
    <span class="summary-hint">&nbsp;</span>
  </div>
  <div class="summary-cell">
    <span class="summary-label">Fat</span>
    <span class="summary-value"><%= daily_log.total_fat.round(0) %> g</span>
    <span class="summary-hint">&nbsp;</span>
  </div>
  <div class="summary-cell">
    <span class="summary-label">Water</span>
    <span class="summary-value"><%= daily_log.water_ml %></span>
    <span class="summary-hint">
      <% left = daily_log.water_remaining_ml(goal) %>
      <% if left.positive? %>
        <%= left %> ml left
      <% else %>
        of <%= goal.water_goal_ml %> ml
      <% end %>
    </span>
  </div>
  <div class="summary-cell">
    <span class="summary-label">Weight</span>
    <span class="summary-value"><%= daily_log.weight_kg || "—" %></span>
    <span class="summary-hint">
      <% if daily_log.weight_kg.blank? %>
        not logged
      <% elsif daily_log.on_period? %>
        kg · period
      <% else %>
        kg
      <% end %>
    </span>
  </div>
</div>

<% if energy.ready? %>
  <p class="small text-muted mb-3 resting-burn-caption">
    Just staying alive uses ~<%= energy.bmr %> kcal/day
    <span class="text-muted">(BMR · Mifflin–St Jeor estimate from your height, age and weight — not a lab measurement).</span>
  </p>
<% end %>

<% if daily_log.calories_burned_breakdown.any? %>
  <p class="small text-muted mb-3">
    Burned:
    <%= daily_log.calories_burned_breakdown.map { |p| "#{p[:label]} #{p[:kcal]} kcal" }.join(" · ") %>
  </p>
<% end %>
