<% content_for :title, @daily_log.logged_on.strftime("%B %-d") %>
<% goal = @goal %>

<header class="day-header mb-3">
  <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
    <div>
      <p class="day-header-eyebrow mb-1">Daily log</p>
      <h1 class="day-header-title mb-0"><%= @daily_log.logged_on.strftime("%A, %B %-d") %></h1>
      <% if @daily_log.compulsive_eating_day? %>
        <span class="badge text-bg-secondary mt-2">Hard eating day</span>
      <% end %>
    </div>
    <div class="d-flex gap-2">
      <%= link_to "All days", daily_logs_path, class: "btn btn-outline-secondary btn-sm" %>
      <%= link_to "Edit day", edit_daily_log_path(@daily_log), class: "btn btn-outline-primary btn-sm" %>
    </div>
  </div>
</header>

<%= render "summary_strip", daily_log: @daily_log, goal: goal %>

<%= render "target_suggestions", suggestions: @target_suggestions %>

<div data-controller="day-tabs"
     data-day-tabs-card-tabs-value="<%= { meals: "food", beverages: "food", water: "food" }.to_json %>">
  <ul class="nav nav-pills day-tabs mb-3" role="tablist">
    <% [
         [ "food", "Food & drink", "bi-egg-fried" ],
         [ "movement", "Movement", "bi-lightning" ],
         [ "body", "Body & mood", "bi-heart-pulse" ],
         [ "photos", "Photos", "bi-camera" ]
       ].each_with_index do |(name, label, icon), index| %>
      <li class="nav-item" role="presentation">
        <button class="nav-link <%= "active" if index.zero? %>"
                id="tab-<%= name %>"
                data-bs-toggle="tab"
                data-bs-target="#pane-<%= name %>"
                data-tab-name="<%= name %>"
                data-action="day-tabs#select"
                type="button"
                role="tab"
                aria-controls="pane-<%= name %>"
                aria-selected="<%= index.zero? %>">
          <i class="bi <%= icon %>"></i>
          <span><%= label %></span>
        </button>
      </li>
    <% end %>
  </ul>

  <div class="tab-content">
    <div class="tab-pane fade show active" id="pane-food" role="tabpanel" aria-labelledby="tab-food">
      <%= render "tab_food", daily_log: @daily_log, goal: goal %>
    </div>
    <div class="tab-pane fade" id="pane-movement" role="tabpanel" aria-labelledby="tab-movement">
      <%= render "tab_movement", daily_log: @daily_log %>
    </div>
    <div class="tab-pane fade" id="pane-body" role="tabpanel" aria-labelledby="tab-body">
      <%= render "tab_body", daily_log: @daily_log, goal: goal %>
    </div>
    <div class="tab-pane fade" id="pane-photos" role="tabpanel" aria-labelledby="tab-photos">
      <%= render "tab_photos", daily_log: @daily_log %>
    </div>
  </div>
</div>
