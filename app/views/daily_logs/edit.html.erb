<h1 class="h3 mb-4">Edit <%= @daily_log.logged_on.strftime("%B %-d") %></h1>

<%= form_with model: @daily_log, class: "row g-3" do |f| %>
  <% if @daily_log.errors.any? %>
    <div class="col-12 alert alert-danger"><%= @daily_log.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="col-md-4">
    <%= f.label :weight_kg, "Weight (kg)", class: "form-label" %>
    <%= f.number_field :weight_kg, step: :any, min: 0, inputmode: "decimal", class: "form-control", placeholder: "e.g. 58.60" %>
  </div>
  <div class="col-md-4 d-flex align-items-end">
    <div class="form-check">
      <%= f.check_box :weight_pre_run, class: "form-check-input" %>
      <%= f.label :weight_pre_run, "Pre-run weigh-in", class: "form-check-label" %>
    </div>
  </div>

  <div class="col-md-3">
    <%= f.label :run_km, "Run (km)", class: "form-label" %>
    <%= f.number_field :run_km, step: :any, inputmode: "decimal", class: "form-control", placeholder: "5.24" %>
  </div>
  <div class="col-md-3">
    <%= f.label :run_calories, "Run calories burned", class: "form-label" %>
    <%= f.number_field :run_calories, class: "form-control" %>
  </div>
  <div class="col-md-3">
    <%= f.label :walk_km, "Walk (km)", class: "form-label" %>
    <%= f.number_field :walk_km, step: :any, inputmode: "decimal", class: "form-control" %>
  </div>
  <div class="col-md-3">
    <%= f.label :walk_calories, "Walk calories burned", class: "form-label" %>
    <%= f.number_field :walk_calories, class: "form-control" %>
  </div>

  <%= render "strength_training", daily_log: @daily_log, runna_strength_today: @runna_strength_today %>

  <div class="col-12">
    <%= f.label :training_notes, class: "form-label" %>
    <%= f.text_area :training_notes, rows: 2, class: "form-control" %>
  </div>

  <div class="col-12">
    <%= f.label :energy_notes, "Energy / training feel", class: "form-label" %>
    <%= f.text_area :energy_notes, rows: 2, class: "form-control" %>
  </div>

  <div class="col-12 mt-2"><h2 class="h5">Wellness check-in</h2></div>

  <div class="col-12">
    <div class="form-check">
      <%= f.check_box :on_period, class: "form-check-input" %>
      <%= f.label :on_period, "On my period today", class: "form-check-label" %>
    </div>
    <div class="form-check mt-2">
      <%= f.check_box :compulsive_eating_day, class: "form-check-input" %>
      <%= f.label :compulsive_eating_day, "Hard / compulsive eating day", class: "form-check-label" %>
      <div class="form-text">Marks the day so you can see the pattern later — no judgment, just a record.</div>
    </div>
  </div>

  <div class="col-12">
    <h2 class="h6">Hard-day debrief <span class="text-muted fw-normal">(optional)</span></h2>
    <div class="mb-2">
      <%= f.label :hard_day_trigger, "What set it off?", class: "form-label small" %>
      <%= f.text_area :hard_day_trigger, rows: 2, class: "form-control" %>
    </div>
    <div class="mb-2">
      <%= f.label :hard_day_what_was_available, "What food was around?", class: "form-label small" %>
      <%= f.text_area :hard_day_what_was_available, rows: 2, class: "form-control" %>
    </div>
    <div>
      <%= f.label :hard_day_next_time, "What might help next time?", class: "form-label small" %>
      <%= f.text_area :hard_day_next_time, rows: 2, class: "form-control" %>
    </div>
  </div>

  <div class="col-md-4">
    <%= f.label :water_ml, "Water (ml)", class: "form-label" %>
    <%= f.number_field :water_ml, class: "form-control", min: 0, step: 50 %>
  </div>

  <%= render "sleep_fields", f: f %>

  <div class="col-12" data-controller="feeling-tags">
    <%= f.label :feeling_check_in, "How am I feeling?", class: "form-label" %>
    <div class="d-flex flex-wrap gap-1 mb-2">
      <% DailyLog::FEELING_TAGS.each do |tag| %>
        <button type="button" class="btn btn-sm btn-light border" data-tag="<%= tag %>" data-action="feeling-tags#append">
          <%= tag %>
        </button>
      <% end %>
    </div>
    <%= f.text_area :feeling_check_in, rows: 2, class: "form-control", data: { feeling_tags_target: "input" } %>
  </div>

  <div class="col-12">
    <%= f.label :notes, "Daily notes", class: "form-label" %>
    <%= f.text_area :notes, rows: 4, class: "form-control", placeholder: "Anything else for the day…" %>
  </div>

  <div class="col-12 d-flex gap-2">
    <%= f.submit "Save day", class: "btn btn-primary" %>
    <%= link_to "Cancel", @daily_log, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
