<%# locals: products, meal_templates, index, selected: nil, quantity: nil, unit: nil %>
<% meal_templates ||= [] %>
<% selected ||= nil %>
<% quantity ||= nil %>
<% unit ||= nil %>
<% grouped = meal_templates.group_by(&:picker_group) %>
<div class="meal-item-row" data-meal-builder-target="row">
  <div class="meal-item-picker" data-controller="searchable-select">
    <select name="items[<%= index %>][picker]" class="form-select form-select-sm"
            aria-label="Item"
            data-searchable-select-target="select"
            data-search-placeholder="Search recipes, batches, products…"
            data-meal-builder-target="product"
            data-action="change->meal-builder#productChanged">
      <option value="">Choose a recipe, batch, or product…</option>
      <% if grouped[:recipes]&.any? %>
        <optgroup label="Recipes">
          <% grouped[:recipes].sort_by(&:name).each do |template| %>
            <%= render "daily_logs/meal_picker_option", template: template, selected: selected %>
          <% end %>
        </optgroup>
      <% end %>
      <% if grouped[:batches]&.any? %>
        <optgroup label="Batch trays">
          <% grouped[:batches].sort_by(&:name).each do |template| %>
            <%= render "daily_logs/meal_picker_option", template: template, selected: selected %>
          <% end %>
        </optgroup>
      <% end %>
      <% if grouped[:saved]&.any? %>
        <optgroup label="Other saved meals">
          <% grouped[:saved].sort_by(&:name).each do |template| %>
            <%= render "daily_logs/meal_picker_option", template: template, selected: selected %>
          <% end %>
        </optgroup>
      <% end %>
      <optgroup label="Products">
        <% products.each do |product| %>
          <option value="product_<%= product.id %>"
            <%= "selected" if selected == "product_#{product.id}" %>
            data-kind="product"
            data-calories="<%= product.calories_per_100g %>"
            data-protein="<%= product.protein_per_100g %>"
            data-carbs="<%= product.carbs_per_100g %>"
            data-fat="<%= product.fat_per_100g %>"
            data-serving-g="<%= product.default_quantity_g %>"
            data-grams-per-ml="<%= product.grams_per_ml.round(3) %>"
            data-units="<%= product.unit_options.to_json %>">
            <%= product.name %><%= " (#{product.brand})" if product.brand.present? %>
          </option>
        <% end %>
      </optgroup>
    </select>
  </div>

  <input type="text" inputmode="decimal" name="items[<%= index %>][quantity]"
         class="form-control form-control-sm meal-item-qty" placeholder="1 or ½"
         value="<%= quantity %>"
         aria-label="Amount" data-meal-builder-target="quantity">

  <select name="items[<%= index %>][unit]" class="form-select form-select-sm meal-item-unit"
          aria-label="Unit" data-meal-builder-target="unit">
    <% if unit.present? %>
      <option value="<%= unit %>" selected><%= unit %></option>
    <% else %>
      <option value="g">g</option>
    <% end %>
  </select>

  <span class="meal-item-hint small text-muted" data-meal-builder-target="hint"></span>

  <button type="button" class="btn btn-sm btn-link text-danger meal-item-remove"
          data-action="meal-builder#removeRow" aria-label="Remove item">
    <i class="bi bi-x-lg"></i>
  </button>
</div>
