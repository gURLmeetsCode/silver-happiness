<%# locals: daily_log, recent %>
<% recent ||= nil %>
<% shortcuts = recent&.shortcuts || [] %>
<% slot_label = recent&.slot_label || "Recent" %>
<section id="meals-quick" class="card day-card mb-3">
  <div class="card-body">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
      <h2 class="h5 mb-0">Usual · <%= slot_label %></h2>
      <%= link_to "Recipes", recipes_path, class: "btn btn-sm btn-link" %>
    </div>
    <p class="small text-muted mb-3">
      Meals you eat often — tap to log last time’s amounts.
      <strong>Tweak</strong> if today’s plate is a little different.
    </p>

    <% if shortcuts.any? %>
      <div class="d-grid gap-2">
        <% shortcuts.each do |shortcut| %>
          <div class="d-flex flex-column flex-sm-row gap-2 align-items-stretch">
            <%= button_to shortcut.label,
                  daily_log_meal_entries_path(daily_log, source_meal_entry_id: shortcut.source_entry.id),
                  method: :post,
                  class: "btn btn-primary text-start flex-grow-1 quick-meal-btn" %>
            <%= link_to "Tweak",
                  new_daily_log_meal_entry_path(daily_log, source_meal_entry_id: shortcut.source_entry.id),
                  class: "btn btn-outline-primary btn-sm align-self-sm-center" %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-muted mb-0">
        No usual <%= slot_label.downcase %> meals yet.
        <%= link_to "Browse recipes", recipes_path %> or build one below — repeats show up here.
      </p>
    <% end %>
  </div>
</section>
