<% content_for :title, "Daily logs" %>

<header class="mb-4">
  <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
    <div>
      <h1 class="h3 mb-1">Daily logs</h1>
      <p class="text-muted mb-0">This week up front — older days by month.</p>
    </div>
    <%= link_to "Journal", journal_path, class: "btn btn-outline-secondary btn-sm" %>
  </div>
</header>

<%= render "shared/profile_nav", active: :logs %>

<section class="mb-4">
  <h2 class="h6 text-uppercase text-muted mb-2">
    This week
    <span class="fw-normal text-muted">
      · <%= @week_start.strftime("%b %-d") %>–<%= @week_end.strftime("%b %-d") %>
    </span>
  </h2>
  <% if @this_week_logs.any? %>
    <div class="list-group">
      <% @this_week_logs.each do |log| %>
        <%= render "daily_logs/log_list_item", log: log %>
      <% end %>
    </div>
  <% else %>
    <p class="text-muted small mb-0">Nothing logged this week yet.</p>
  <% end %>
</section>

<section>
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
    <h2 class="h6 text-uppercase text-muted mb-0"><%= @focus_month.strftime("%B %Y") %></h2>
    <div class="d-flex gap-2">
      <% if @prev_month %>
        <%= link_to "← #{@prev_month.strftime("%b %Y")}", daily_logs_path(month: @prev_month.strftime("%Y-%m")), class: "btn btn-outline-secondary btn-sm" %>
      <% end %>
      <% if @next_month %>
        <%= link_to "#{@next_month.strftime("%b %Y")} →", daily_logs_path(month: @next_month.strftime("%Y-%m")), class: "btn btn-outline-secondary btn-sm" %>
      <% end %>
    </div>
  </div>

  <% if @month_logs.any? %>
    <div class="list-group">
      <% @month_logs.each do |log| %>
        <%= render "daily_logs/log_list_item", log: log %>
      <% end %>
    </div>
  <% else %>
    <p class="text-muted small mb-0">
      <% if @focus_month == Date.current.beginning_of_month %>
        No earlier days this month outside this week.
      <% else %>
        No logs in <%= @focus_month.strftime("%B %Y") %>.
      <% end %>
    </p>
  <% end %>
</section>
