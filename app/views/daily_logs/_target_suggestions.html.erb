<% if suggestions.relevant? %>
  <div class="alert alert-warning border-warning mb-4">
    <div class="fw-semibold"><%= suggestions.headline %></div>
    <% if suggestions.subheadline.present? %>
      <p class="small mb-2 mt-1 mb-0"><%= suggestions.subheadline %></p>
    <% end %>
    <% if suggestions.suggestions.any? %>
      <ul class="small mb-0 ps-3 mt-2">
        <% suggestions.suggestions.each do |tip| %>
          <li>
            <%= tip.message %>
            <% if tip.savings_kcal.positive? && !tip.message.include?("would hit") %>
              <span class="text-muted">(−<%= tip.savings_kcal %> kcal)</span>
            <% end %>
            <% if tip.adds_protein_g.positive? %>
              <span class="text-muted">(+<%= tip.adds_protein_g.round(0) %> g protein)</span>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
<% end %>
