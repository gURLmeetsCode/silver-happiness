<%# locals: daily_log, goal %>
<%= render "water", daily_log: daily_log, goal: goal %>

<%= render "recent_meals", daily_log: daily_log, recent: @recent_meals %>

<section id="meals" class="card day-card mb-3">
  <div class="card-body">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
      <h2 class="h5 mb-0">Meals today</h2>
    </div>

    <% if @yesterday_log&.meal_entries&.any? %>
      <details class="border rounded px-3 py-2 mb-3 bg-light">
        <summary class="fw-semibold" style="cursor: pointer">Copy from yesterday</summary>
        <p class="small text-muted mt-2 mb-2">
          Pick which meals to bring over from <%= @yesterday_log.logged_on.strftime("%a %b %-d") %>.
          Ingredients come with them so you can edit amounts after.
        </p>
        <%= form_with url: copy_meals_daily_log_path(daily_log), method: :post do %>
          <%= hidden_field_tag :source_id, @yesterday_log.id %>
          <div class="d-flex flex-column gap-2 mb-3">
            <% @yesterday_log.meal_entries.each do |entry| %>
              <div class="form-check">
                <%= check_box_tag "meal_entry_ids[]", entry.id, false,
                      id: "copy_meal_#{entry.id}", class: "form-check-input" %>
                <%= label_tag "copy_meal_#{entry.id}", class: "form-check-label" do %>
                  <span class="fw-semibold"><%= entry.name %></span>
                  <span class="text-muted small">
                    · <%= meal_type_label(entry.meal_type) %> · <%= entry.calories %> kcal
                  </span>
                <% end %>
              </div>
            <% end %>
          </div>
          <%= submit_tag "Copy selected", class: "btn btn-sm btn-outline-primary" %>
        <% end %>
      </details>
    <% end %>

    <% if daily_log.meal_entries.any? %>
      <ul class="list-group list-group-flush mb-0">
        <% daily_log.meal_entries.each do |entry| %>
          <li class="list-group-item px-0">
            <div class="d-flex justify-content-between align-items-start gap-2">
              <div class="flex-grow-1">
                <div class="fw-semibold"><%= entry.name %></div>
                <div class="small text-muted">
                  <%= meal_type_label(entry.meal_type) %>
                  · <%= entry.calories %> kcal
                  · <%= entry.protein_g %>g protein
                  <% if entry.carbs_g.to_f.positive? %> · <%= entry.carbs_g %>g carbs<% end %>
                  <% if entry.fat_g.to_f.positive? %> · <%= entry.fat_g %>g fat<% end %>
                </div>
                <% if entry.notes.present? %><div class="small"><%= entry.notes %></div><% end %>
                <div class="mt-2 d-flex flex-wrap align-items-center gap-2">
                  <% if entry.water_logged? %>
                    <span class="badge text-bg-info">
                      <i class="bi bi-droplet-fill"></i> <%= entry.water_logged_ml %> ml water
                    </span>
                  <% elsif entry.shows_meal_water_actions? %>
                    <span class="small text-muted"><%= entry.water_prompt %></span>
                    <%= button_to log_water_daily_log_meal_entry_path(daily_log, entry), method: :post,
                          class: "btn btn-sm btn-info",
                          title: "Log #{entry.water_suggestion_ml} ml" do %>
                      <i class="bi bi-plus-lg"></i> <%= entry.water_cups_label %>
                    <% end %>
                  <% end %>
                </div>
              </div>
              <div class="d-flex flex-column flex-sm-row gap-1">
                <%= link_to entry.items.any? || entry.meal_template&.recipe ? "Edit ingredients" : "Edit",
                      edit_daily_log_meal_entry_path(daily_log, entry),
                      class: "btn btn-sm btn-outline-primary" %>
                <%= button_to "Remove", daily_log_meal_entry_path(daily_log, entry), method: :delete,
                      class: "btn btn-sm btn-outline-danger",
                      form: { data: { turbo_confirm: "Remove?" } } %>
              </div>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-muted mb-0">No meals yet today.</p>
    <% end %>
  </div>
</section>

<%= render "daily_logs/build_meal", daily_log: daily_log, products: @products, meal_templates: @meal_templates %>

<section class="card day-card mb-3">
  <div class="card-body">
    <h2 class="h5 mb-3">Other ways to add</h2>

    <div class="accordion accordion-flush" id="add-meal-accordion">
      <div class="accordion-item">
        <h3 class="accordion-header">
          <button class="accordion-button collapsed px-0" type="button"
                  data-bs-toggle="collapse" data-bs-target="#add-custom-meal">
            I already know the numbers
          </button>
        </h3>
        <div id="add-custom-meal" class="accordion-collapse collapse" data-bs-parent="#add-meal-accordion">
          <div class="accordion-body px-0">
            <%= form_with url: daily_log_meal_entries_path(daily_log), method: :post,
                  data: {
                    controller: "meal-calculator",
                    meal_calculator_current_calories_value: daily_log.total_calories,
                    meal_calculator_current_protein_value: daily_log.total_protein.to_f,
                    meal_calculator_protein_min_value: goal.protein_min_g,
                    meal_calculator_calorie_target_value: daily_log.calorie_target
                  },
                  class: "row g-2" do %>
              <%= fields_for :meal_entry, @custom_meal do |f| %>
                <div class="col-md-6">
                  <%= f.label :name, class: "form-label" %>
                  <%= f.text_field :name, class: "form-control", required: true, placeholder: "e.g. Nantes burger + fries" %>
                </div>
                <div class="col-md-6">
                  <%= f.label :meal_type, class: "form-label" %>
                  <%= f.select :meal_type, MealEntry.meal_types.keys.map { |k| [ meal_type_label(k), k ] }, {}, class: "form-select" %>
                </div>
                <div class="col-6 col-md-3">
                  <%= f.label :calories, class: "form-label" %>
                  <%= f.number_field :calories, class: "form-control", required: true, data: { meal_calculator_target: "calories", action: "input->meal-calculator#recalculate" } %>
                </div>
                <div class="col-6 col-md-3">
                  <%= f.label :protein_g, "Protein (g)", class: "form-label" %>
                  <%= f.number_field :protein_g, step: 0.1, class: "form-control", required: true, data: { meal_calculator_target: "protein", action: "input->meal-calculator#recalculate" } %>
                </div>
                <div class="col-6 col-md-3">
                  <%= f.label :carbs_g, "Carbs (g)", class: "form-label" %>
                  <%= f.number_field :carbs_g, step: 0.1, class: "form-control", data: { meal_calculator_target: "carbs" } %>
                </div>
                <div class="col-6 col-md-3">
                  <%= f.label :fat_g, "Fat (g)", class: "form-label" %>
                  <%= f.number_field :fat_g, step: 0.1, class: "form-control", data: { meal_calculator_target: "fat" } %>
                </div>
                <div class="col-12">
                  <%= f.label :notes, class: "form-label" %>
                  <%= f.text_field :notes, class: "form-control" %>
                </div>
              <% end %>
              <div class="col-12">
                <div class="alert alert-light border small mb-2">
                  If saved: <span data-meal-calculator-target="previewCalories">—</span> ·
                  <span data-meal-calculator-target="previewProtein">—</span> ·
                  <span data-meal-calculator-target="previewRemainingProtein">—</span>
                </div>
                <%= submit_tag "Add custom meal", class: "btn btn-primary" %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
