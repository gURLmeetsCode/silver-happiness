<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
  <div>
    <h1 class="h3 mb-1">Outfit gallery</h1>
    <p class="text-muted mb-0">Workout fits, everyday clothes, feeling cute, and gentle reality checks.</p>
  </div>
  <%= link_to "Snap new photo", new_outfit_photo_path, class: "btn btn-primary" %>
</div>

<div class="d-flex flex-wrap gap-2 mb-4">
  <%= link_to "All", outfit_photos_path, class: "btn btn-sm #{params[:category].blank? ? 'btn-dark' : 'btn-outline-dark'}" %>
  <% OutfitPhoto.categories.each_key do |key| %>
    <%= link_to OutfitPhoto::CATEGORY_LABELS[key], outfit_photos_path(category: key), class: "btn btn-sm #{params[:category] == key ? 'btn-dark' : 'btn-outline-dark'}" %>
  <% end %>
</div>

<% if @outfit_photos.any? %>
  <div class="photo-grid">
    <% @outfit_photos.each do |photo| %>
      <div class="card stat-card photo-card">
        <%= image_tag photo.image.variant(resize_to_limit: [600, 800]), alt: photo.category_label %>
        <div class="card-body p-2">
          <div class="badge text-bg-light border mb-1"><%= photo.category_label %></div>
          <div class="small text-muted"><%= photo.logged_on.strftime("%b %-d, %Y") %></div>
          <% if photo.caption.present? %><div class="small mt-1"><%= photo.caption %></div><% end %>
          <% if photo.note.present? %><div class="small text-muted mt-1"><%= photo.note %></div><% end %>
          <%= button_to "Remove", outfit_photo_path(photo), method: :delete, class: "btn btn-sm btn-link text-danger p-0 mt-1", form: { data: { turbo_confirm: "Remove this photo?" } } %>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="upload-zone text-center">
    <p class="mb-3">No photos yet. Take one from your phone — it only takes a few seconds.</p>
    <%= link_to "Feeling cute snap", new_outfit_photo_path(category: :feeling_cute), class: "btn btn-dark me-2" %>
    <%= link_to "Reality check snap", new_outfit_photo_path(category: :reality_check), class: "btn btn-outline-secondary" %>
  </div>
<% end %>
