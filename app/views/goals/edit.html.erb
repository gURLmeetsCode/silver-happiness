<h1 class="h3 mb-4">Your goals</h1>
<p class="text-muted">Adjust targets anytime. Charts and weekly status use these numbers.</p>

<%= form_with model: @goal, url: goal_path, method: :patch, class: "row g-3" do |f| %>
  <% if @goal.errors.any? %>
    <div class="col-12 alert alert-danger"><%= @goal.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="col-12"><h2 class="h5">You</h2></div>
  <div class="col-md-6">
    <%= f.label :display_name, "Name (used on the home screen)", class: "form-label" %>
    <%= f.text_field :display_name, class: "form-control", placeholder: "e.g. Natasha" %>
  </div>

  <div class="col-12 mt-2"><h2 class="h5">Body profile</h2></div>
  <p class="col-12 text-muted small mb-0">
    Used to estimate maintenance calories (Mifflin–St Jeor). For a petite woman around your size,
    guidelines point to a <strong>250–500 kcal/day</strong> deficit — roughly 0.25–0.5 kg per week —
    and not eating below 1,200 kcal without medical advice.
  </p>
  <div class="col-md-3">
    <%= f.label :height_cm, "Height (cm)", class: "form-label" %>
    <%= f.number_field :height_cm, step: 0.1, class: "form-control" %>
  </div>
  <div class="col-md-3">
    <%= f.label :age_years, "Age", class: "form-label" %>
    <%= f.number_field :age_years, class: "form-control", min: 16, max: 99 %>
  </div>
  <div class="col-md-3">
    <%= f.label :sex, class: "form-label" %>
    <%= f.select :sex, Goal::SEXES.map { |s| [ s.capitalize, s ] }, {}, class: "form-select" %>
  </div>
  <div class="col-md-3">
    <%= f.label :activity_level, "Activity", class: "form-label" %>
    <%= f.select :activity_level,
          EnergyEstimate::ACTIVITY_LABELS.map { |value, label| [ label, value ] },
          {}, class: "form-select" %>
  </div>
  <div class="col-md-4">
    <%= f.label :target_deficit_kcal, "Daily deficit goal (kcal)", class: "form-label" %>
    <%= f.number_field :target_deficit_kcal, class: "form-control", min: 100, max: 1000, step: 50,
          placeholder: "400" %>
    <div class="form-text">Leave blank to use the size-based default (~400).</div>
  </div>
  <% if @energy&.ready? %>
    <div class="col-12">
      <div class="alert alert-light border small mb-0">
        <%= @energy.summary_line %>
        Suggested intake ~<%= @energy.recommended_intake %> kcal/day.
        Your current targets are <%= @goal.calories_rest_day %> rest /
        <%= @goal.calories_training_day %> training.
      </div>
    </div>
  <% end %>

  <div class="col-12 mt-2"><h2 class="h5">Weight</h2></div>
  <div class="col-md-4">
    <%= f.label :target_weight_kg, "Target weight (kg)", class: "form-label" %>
    <%= f.number_field :target_weight_kg, step: 0.01, class: "form-control" %>
  </div>
  <div class="col-md-4">
    <%= f.label :starting_weight_kg, "Starting weight (kg)", class: "form-label" %>
    <%= f.number_field :starting_weight_kg, step: 0.01, class: "form-control" %>
  </div>
  <div class="col-md-4">
    <%= f.label :target_date, "Target date", class: "form-label" %>
    <%= f.date_field :target_date, class: "form-control" %>
  </div>

  <div class="col-12 mt-2"><h2 class="h5">Protein</h2></div>
  <div class="col-md-6">
    <%= f.label :protein_min_g, "Daily minimum (g)", class: "form-label" %>
    <%= f.number_field :protein_min_g, class: "form-control" %>
  </div>
  <div class="col-md-6">
    <%= f.label :protein_max_g, "Daily maximum (g)", class: "form-label" %>
    <%= f.number_field :protein_max_g, class: "form-control" %>
  </div>

  <div class="col-12 mt-2"><h2 class="h5">Calories</h2></div>
  <div class="col-md-6">
    <%= f.label :calories_training_day, "Training day target (kcal)", class: "form-label" %>
    <%= f.number_field :calories_training_day, class: "form-control" %>
  </div>
  <div class="col-md-6">
    <%= f.label :calories_rest_day, "Rest day target (kcal)", class: "form-label" %>
    <%= f.number_field :calories_rest_day, class: "form-control" %>
  </div>

  <div class="col-12 mt-2"><h2 class="h5">Wellness</h2></div>
  <div class="col-md-6">
    <%= f.label :water_goal_ml, "Daily water goal (ml)", class: "form-label" %>
    <%= f.number_field :water_goal_ml, class: "form-control", min: 500, step: 250 %>
  </div>

  <div class="col-12 d-flex gap-2">
    <%= f.submit "Save goals", class: "btn btn-primary" %>
    <%= link_to "Cancel", root_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
