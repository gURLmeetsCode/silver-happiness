<%# locals: guide (GestationalWeightGuidance) %>
<% return unless guide&.ready? %>
<section class="card stat-card mb-4 border-info border-opacity-25">
  <div class="card-body">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
      <div>
        <h2 class="h5 mb-1">Pregnancy weight path</h2>
        <p class="small text-muted mb-0">
          Week <%= guide.gestational_week %> · trimester <%= guide.trimester %> ·
          pre-pregnancy BMI <%= guide.bmi %> (<%= guide.band[:label] %>)
        </p>
      </div>
      <%= link_to "Mode settings", edit_goal_path, class: "btn btn-sm btn-outline-secondary" %>
    </div>
    <div class="row g-3">
      <div class="col-6 col-md-3">
        <div class="text-muted small">IOM total gain</div>
        <div class="fw-semibold"><%= guide.band[:total_min_kg] %>–<%= guide.band[:total_max_kg] %> kg</div>
        <div class="small text-muted">Mindful target: lower bound</div>
      </div>
      <div class="col-6 col-md-3">
        <div class="text-muted small">Lower path today</div>
        <div class="fw-semibold">~<%= guide.expected_lower_weight_kg %> kg</div>
        <div class="small text-muted">+<%= guide.expected_lower_gain_kg %> kg from baseline</div>
      </div>
      <div class="col-6 col-md-3">
        <div class="text-muted small">Term lower bound</div>
        <div class="fw-semibold">~<%= guide.term_lower_weight_kg %> kg</div>
        <div class="small text-muted">Upper IOM ~<%= guide.term_upper_weight_kg %> kg</div>
      </div>
      <div class="col-6 col-md-3">
        <div class="text-muted small">Source</div>
        <div class="small"><%= GestationalWeightGuidance::SOURCE_LABEL %></div>
      </div>
    </div>
    <p class="small text-muted mb-0 mt-3">
      Not medical advice. Individualize with your clinician if you gain less than recommended
      while fetal growth is appropriate (ACOG).
    </p>
  </div>
</section>
