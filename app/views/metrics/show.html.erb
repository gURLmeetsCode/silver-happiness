<% content_for :title, "Metrics" %>
<% content_for :head do %>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chartkick@5.0.1/dist/chartkick.min.js"></script>
<% end %>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
  <div>
    <h1 class="h3 mb-1">Metrics</h1>
    <p class="text-muted mb-0"><%= Date.current.strftime("%A, %B %-d") %></p>
  </div>
  <div class="d-flex flex-wrap gap-2">
    <%= link_to export_metrics_path, class: "btn btn-outline-dark" do %>
      <i class="bi bi-filetype-pdf me-1"></i> Export PDF
    <% end %>
    <%= link_to "Today’s log", daily_log_path(@today), class: "btn btn-outline-secondary" %>
  </div>
</div>

<%# --- Patterns (the analysis the weekly charts alone don't show) --- %>
<section class="card stat-card mb-4">
  <div class="card-body">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
      <div>
        <h2 class="h5 mb-1">What the data says</h2>
        <p class="text-muted small mb-0">
          Last <%= MetricsTrends::LOOKBACK_DAYS %> days — rolling weight, weekday vs weekend, intake vs maintenance.
        </p>
      </div>
    </div>

    <p class="mb-3"><%= @trends.headline %></p>

    <% if @trends.ready? %>
      <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
          <div class="border rounded p-2 bg-white h-100">
            <div class="small text-muted">7-day avg weight</div>
            <div class="fs-5 fw-semibold"><%= @trends.rolling_latest ? "#{@trends.rolling_latest} kg" : "—" %></div>
            <% if @trends.weight_delta %>
              <div class="small text-muted"><%= @trends.weight_delta %> kg this window</div>
            <% end %>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="border rounded p-2 bg-white h-100">
            <div class="small text-muted">Avg eaten</div>
            <div class="fs-5 fw-semibold"><%= @trends.avg_eaten ? "#{@trends.avg_eaten}" : "—" %></div>
            <div class="small text-muted">
              <% if @trends.tdee %>
                vs ~<%= @trends.tdee %> TDEE
                <% if @trends.gap_vs_tdee %>
                  · <%= @trends.gap_vs_tdee >= 0 ? "−" : "+" %><%= @trends.gap_vs_tdee.abs %>/day
                <% end %>
              <% else %>
                kcal/day
              <% end %>
            </div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="border rounded p-2 bg-white h-100">
            <div class="small text-muted">Weekday / weekend</div>
            <div class="fs-5 fw-semibold">
              <%= @trends.weekday_avg || "—" %><span class="text-muted fw-normal"> / </span><%= @trends.weekend_avg || "—" %>
            </div>
            <div class="small text-muted">avg kcal</div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="border rounded p-2 bg-white h-100">
            <div class="small text-muted">To <%= @trends.target_weight %> kg</div>
            <div class="fs-5 fw-semibold">
              <% if @trends.kg_to_goal %>
                <%= @trends.kg_to_goal.positive? ? "#{@trends.kg_to_goal} kg" : "At/under" %>
              <% else %>
                —
              <% end %>
            </div>
            <div class="small text-muted"><%= weight_vs_goal_label(@goal, @trends.last_weight || @today.weight_kg) %></div>
          </div>
        </div>
      </div>

      <% if @trends.insights.any? %>
        <div class="row g-3 mb-4">
          <% @trends.insights.each do |insight| %>
            <div class="col-12 col-md-6">
              <div class="metrics-insight metrics-insight--<%= insight.tone %>">
                <div class="fw-semibold mb-1"><%= insight.title %></div>
                <p class="small mb-0"><%= insight.body %></p>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>

      <% if @trends.weight_series.any? %>
        <h3 class="h6 text-muted">Weight + 7-day rolling average</h3>
        <p class="small text-muted mb-2">Daily scale jumps; the rolling line is the cut signal.</p>
        <%= line_chart [
              {
                name: "Morning weight",
                data: @trends.weight_series,
                dataset: { borderColor: "#345c67", backgroundColor: "transparent", pointRadius: 3 }
              },
              {
                name: "7-day average",
                data: @trends.rolling_weight_series,
                dataset: { borderColor: "#b85c38", backgroundColor: "transparent", pointRadius: 0, borderWidth: 2.5 }
              },
              {
                name: "Target",
                data: @trends.weight_series.map { |label, _| [ label, @trends.target_weight ] },
                dataset: { borderColor: "#8a9a9e", borderDash: [ 6, 4 ], pointRadius: 0, backgroundColor: "transparent" }
              }
            ], suffix: " kg", library: { scales: { y: { beginAtZero: false } } } %>
      <% end %>

      <% if @trends.weekly_avg_eaten.any? %>
        <h3 class="h6 text-muted mt-4">Weekly average calories eaten</h3>
        <p class="small text-muted mb-2">
          One bar per week. Maintenance ~<%= @trends.tdee || "—" %> kcal —
          weeks above that undo quieter ones.
        </p>
        <%= column_chart [
              { name: "Avg eaten", data: @trends.weekly_avg_eaten }
            ], suffix: " kcal", library: { scales: { y: { beginAtZero: false } } } %>
      <% end %>

      <% if @trends.spikes.any? %>
        <h3 class="h6 text-muted mt-4">Highest days (≥ 2,100 kcal)</h3>
        <div class="table-responsive">
          <table class="table table-sm align-middle mb-0">
            <thead>
              <tr>
                <th>Date</th>
                <th class="text-end">Eaten</th>
                <th>What stood out</th>
              </tr>
            </thead>
            <tbody>
              <% @trends.spikes.each do |spike| %>
                <tr>
                  <td><%= spike.date.strftime("%a %-d %b") %></td>
                  <td class="text-end fw-semibold"><%= spike.calories %></td>
                  <td class="small text-muted"><%= spike.label %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    <% else %>
      <p class="text-muted small mb-0">Keep logging meals and weight — patterns show up after about a week.</p>
    <% end %>
  </div>
</section>

<%# --- Today (compact) --- %>
<h2 class="h6 text-uppercase text-muted mb-2">Today</h2>
<div class="row g-3 mb-4">
  <div class="col-6 col-md-3">
    <div class="card stat-card h-100">
      <div class="card-body">
        <div class="text-muted small">Weight</div>
        <div class="fs-4 fw-semibold"><%= @today.weight_kg.present? ? "#{@today.weight_kg} kg" : "—" %></div>
        <% if @goal.life_stage_pregnancy? && @pregnancy_guide&.ready? %>
          <div class="small mt-1"><%= pregnancy_gain_badge(@pregnancy_guide.gain_status(@today.weight_kg)) %></div>
          <div class="small text-muted"><%= weight_vs_goal_label(@goal, @today.weight_kg) %></div>
        <% elsif @today.on_period? %>
          <div class="small mt-1"><span class="badge text-bg-light text-dark border">Period day</span></div>
          <div class="small text-muted">Scale may be up from water — normal this week of your cycle.</div>
        <% else %>
          <div class="small mt-1"><%= target_status_badge(@goal.weight_status(@today.weight_kg)) %></div>
          <div class="small text-muted"><%= weight_vs_goal_label(@goal, @today.weight_kg) %></div>
        <% end %>
      </div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="card stat-card h-100">
      <div class="card-body">
        <div class="text-muted small">Protein</div>
        <div class="fs-4 fw-semibold"><%= @today.total_protein.round(0) %> g</div>
        <div class="small mt-1"><%= target_status_badge(@goal.protein_status(@today.total_protein)) %></div>
        <div class="small text-muted">goal <%= @goal.protein_min_g %>–<%= @goal.protein_max_g %> g</div>
      </div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="card stat-card h-100">
      <div class="card-body">
        <div class="text-muted small">Calories eaten</div>
        <div class="fs-4 fw-semibold"><%= @today.total_calories %></div>
        <div class="small text-muted">target ~<%= @today.calorie_target %> kcal</div>
        <div class="small mt-1"><%= target_status_badge(@goal.calorie_status(@today.total_calories, @today.calories_burned, @today.calorie_target)) %></div>
      </div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="card stat-card h-100">
      <div class="card-body">
        <div class="text-muted small">Burned today</div>
        <div class="fs-4 fw-semibold"><%= @today.calories_burned %></div>
        <div class="small text-muted">
          net <%= @today.net_calories %> kcal
          <% if @today.calories_burned_breakdown.any? %>
            · <%= @today.calories_burned_breakdown.map { |p| "#{p[:label]} #{p[:kcal]}" }.join(" · ") %>
          <% end %>
        </div>
        <% if (energy = @goal.energy_estimate(weight_kg: @today.weight_kg)).ready? %>
          <div class="small text-muted mt-1">At rest ~<%= energy.bmr %> kcal/day (BMR)</div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<%= render "metrics/pregnancy_weight", guide: @pregnancy_guide if @pregnancy_guide %>

<div class="row g-3 mb-4">
  <div class="col-6 col-md-4">
    <div class="card stat-card h-100 border-info border-opacity-25">
      <div class="card-body">
        <div class="text-muted small">Water</div>
        <div class="fs-4 fw-semibold"><%= @today.water_ml %> ml</div>
        <div class="small text-muted">~<%= @today.water_glasses %> glasses · goal <%= @goal.water_goal_ml %> ml</div>
        <div class="small mt-1"><%= link_to "Update bottle →", daily_log_path(@today, anchor: "water") %></div>
      </div>
    </div>
  </div>
  <div class="col-6 col-md-4">
    <div class="card stat-card h-100">
      <div class="card-body">
        <div class="text-muted small">Sleep</div>
        <div class="fs-4 fw-semibold"><%= @today.sleep_duration_hours ? "#{@today.sleep_duration_hours}h" : "—" %></div>
        <div class="small text-muted"><%= @today.sleep_summary.presence || "Log bed & wake time" %></div>
      </div>
    </div>
  </div>
  <div class="col-12 col-md-4">
    <div class="card stat-card h-100">
      <div class="card-body">
        <div class="text-muted small">Period</div>
        <div class="fs-4 fw-semibold"><%= @today.on_period? ? "Yes" : "No" %></div>
        <% if @cycle.period_days_in_window.positive? %>
          <div class="small text-muted"><%= @cycle.period_days_in_window %> day<%= @cycle.period_days_in_window == 1 ? "" : "s" %> marked in last <%= WeightCycleInsight::DAYS %></div>
        <% else %>
          <div class="small text-muted">Not marked lately</div>
        <% end %>
        <div class="small mt-1"><%= link_to "Update →", edit_daily_log_path(@today) %></div>
      </div>
    </div>
  </div>
</div>

<%# --- This week --- %>
<div class="card stat-card mb-4">
  <div class="card-body">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
      <div>
        <h2 class="h5 mb-0">This week</h2>
        <p class="text-muted small mb-0"><%= @week.week_label %></p>
      </div>
      <%= target_status_badge(@week.calorie_balance_status) %>
    </div>

    <div class="row g-3 mb-4">
      <div class="col-6 col-md-3">
        <div class="border rounded p-2 bg-white">
          <div class="small text-muted">Avg weight</div>
          <div class="fw-semibold"><%= @week.avg_weight ? "#{@week.avg_weight} kg" : "—" %></div>
          <%= target_status_badge(@goal.weight_status(@week.latest_weight)) %>
          <% if @week.period_weigh_ins_this_week.positive? %>
            <div class="small text-muted mt-1">
              Includes <%= @week.period_weigh_ins_this_week %> period weigh-in<%= @week.period_weigh_ins_this_week == 1 ? "" : "s" %>
            </div>
          <% end %>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="border rounded p-2 bg-white">
          <div class="small text-muted">Total eaten</div>
          <div class="fw-semibold"><%= @week.total_eaten %> kcal</div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="border rounded p-2 bg-white">
          <div class="small text-muted">Total burned</div>
          <div class="fw-semibold"><%= @week.total_burned %> kcal</div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="border rounded p-2 bg-white">
          <div class="small text-muted">Protein days on target</div>
          <div class="fw-semibold"><%= @week.days_on_protein_target %> / <%= @week.logs.size %></div>
          <div class="small text-muted">avg <%= @week.avg_daily_protein %> g/day</div>
        </div>
      </div>
    </div>

    <% if @week.deficit_ready? %>
      <div class="border rounded p-3 bg-white mb-4">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
          <div>
            <h3 class="h6 mb-1">Calorie deficit this week</h3>
            <p class="small text-muted mb-0"><%= @week.energy.summary_line %></p>
          </div>
          <%= deficit_pace_badge(@week.deficit_pace_status) %>
        </div>
        <div class="row g-3 mb-3">
          <div class="col-6 col-md-4">
            <div class="small text-muted">Actual deficit so far</div>
            <div class="fs-5 fw-semibold"><%= @week.week_deficit_kcal %> kcal</div>
            <div class="small text-muted">
              ≈ <%= @week.projected_week_loss_kg %> kg
              <% if @week.projected_week_loss_kg.negative? %>gain<% else %>loss<% end %>
            </div>
          </div>
          <div class="col-6 col-md-4">
            <div class="small text-muted">Planned for <%= @week.logs.size %> day<%= @week.logs.size == 1 ? "" : "s" %></div>
            <div class="fs-5 fw-semibold"><%= @week.energy.recommended_deficit * @week.logs.size %> kcal</div>
            <div class="small text-muted">≈ <%= @week.planned_week_loss_kg %> kg loss</div>
          </div>
          <div class="col-12 col-md-4">
            <div class="small text-muted">Full-week pace</div>
            <div class="fs-5 fw-semibold">~<%= @week.energy.expected_weekly_loss_kg %> kg</div>
            <div class="small text-muted">if you hold a <%= @week.energy.recommended_deficit %> kcal/day deficit</div>
          </div>
        </div>

        <h4 class="h6 text-muted">Cumulative deficit vs plan</h4>
        <%= line_chart [
              { name: "Actual deficit", data: @week.cumulative_deficit_by_day },
              { name: "Planned pace", data: @week.planned_cumulative_deficit_by_day }
            ], suffix: " kcal", library: { scales: { y: { beginAtZero: true } } } %>

        <h4 class="h6 text-muted mt-4">Daily deficit (maintenance − eaten)</h4>
        <%= column_chart [
              { name: "Actual", data: @week.daily_deficit },
              { name: "Goal", data: @week.planned_deficit_line }
            ], suffix: " kcal", library: { scales: { x: { stacked: false }, y: { stacked: false } } } %>
        <p class="small text-muted mb-0 mt-2">
          Positive bars mean a deficit (on track to lose). Negative means a surplus that day.
          Maintenance is estimated from your body profile, not from tracker burn — so exercise
          calories already counted into “moderate activity” are not added again.
        </p>
      </div>
    <% elsif @week.energy.ready? == false %>
      <div class="alert alert-light border small mb-4">
        Add height, age and activity under
        <%= link_to "Goals", edit_goal_path %>
        to see whether this week’s deficit is on pace for your target loss.
      </div>
    <% end %>

    <% if @week.logs.any? %>
      <h3 class="h6 text-muted">Calories eaten vs burned vs target</h3>
      <%= column_chart [
            { name: "Eaten", data: @week.eaten_by_day },
            { name: "Burned (tracker)", data: @week.burned_by_day },
            { name: "Target", data: @week.target_by_day }
          ], stacked: false, suffix: " kcal", library: { scales: { x: { stacked: false }, y: { stacked: false } } } %>

      <h3 class="h6 text-muted mt-4">Protein vs goal (<%= @goal.protein_min_g %> g min)</h3>
      <%= column_chart [
            { name: "Protein", data: @week.protein_by_day },
            { name: "Min goal", data: @week.protein_min_line }
          ], suffix: " g" %>
    <% else %>
      <p class="text-muted mb-0">Log a few days this week to see weekly charts.</p>
    <% end %>
  </div>
</div>

<%# --- Cycle context (period water) --- %>
<div class="card stat-card">
  <div class="card-body">
    <h2 class="h5 mb-1">Cycle &amp; the scale</h2>
    <p class="small text-muted mb-3">
      Last <%= WeightCycleInsight::DAYS %> days. Period weigh-ins often look like stalls — usually water.
    </p>
    <% if @weight_data.any? %>
      <%= line_chart [
            {
              name: "Weight",
              data: @weight_data,
              dataset: { borderColor: "#345c67", backgroundColor: "transparent", pointRadius: 3 }
            },
            {
              name: "On period",
              data: @weight_period_data,
              dataset: {
                borderColor: "transparent",
                backgroundColor: "#b85c38",
                pointBackgroundColor: "#b85c38",
                pointBorderColor: "#b85c38",
                pointRadius: 7,
                pointHoverRadius: 8,
                showLine: false,
                spanGaps: false
              }
            },
            {
              name: "Target",
              data: @weight_target_line,
              dataset: { borderColor: "#8a9a9e", borderDash: [ 6, 4 ], pointRadius: 0, backgroundColor: "transparent" }
            }
          ], suffix: " kg", library: { scales: { y: { beginAtZero: false } } } %>

      <div class="border rounded p-3 bg-white mt-3">
        <% if @cycle.enough_to_compare? %>
          <div class="row g-3 mb-2">
            <div class="col-6 col-md-4">
              <div class="small text-muted">Avg on period</div>
              <div class="fw-semibold"><%= @cycle.on_period_avg %> kg</div>
              <div class="small text-muted"><%= @cycle.period_days_with_weight %> weigh-ins</div>
            </div>
            <div class="col-6 col-md-4">
              <div class="small text-muted">Avg off period</div>
              <div class="fw-semibold"><%= @cycle.off_period_avg %> kg</div>
              <div class="small text-muted"><%= @cycle.off_days_with_weight %> weigh-ins</div>
            </div>
            <div class="col-12 col-md-4">
              <div class="small text-muted">Typical swing</div>
              <div class="fw-semibold">
                <% delta = @cycle.cycle_delta %>
                <% if delta.positive? %>+<%= delta %> kg<% elsif delta.negative? %><%= delta %> kg<% else %>~0 kg<% end %>
              </div>
              <div class="small text-muted">on vs off period</div>
            </div>
          </div>
        <% end %>
        <p class="small text-muted mb-0"><%= @cycle.summary %></p>
      </div>
    <% else %>
      <p class="text-muted mb-0">Log weight on your daily page to see a chart.</p>
    <% end %>
  </div>
</div>
