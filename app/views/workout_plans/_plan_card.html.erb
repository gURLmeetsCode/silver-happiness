<div class="card stat-card h-100<%= " border-primary border-2" if highlight %>">
  <div class="card-body d-flex flex-column">
    <div class="d-flex justify-content-between align-items-start mb-2">
      <h3 class="h5 mb-0"><%= plan.name %></h3>
      <span class="badge text-bg-secondary"><%= plan.location_label %></span>
    </div>
    <p class="small text-muted mb-1">
      <%= plan.plan_kind_label %>
      · <%= plan.scheduled_day_name %>
      <% if plan.duration_hint.present? %> · <%= plan.duration_hint %><% end %>
    </p>
    <% if plan.description.present? %>
      <p class="small mb-3"><%= plan.description %></p>
    <% end %>
    <ol class="small mb-3 ps-3">
      <% plan.workout_plan_exercises.each do |ex| %>
        <li class="mb-1">
          <strong><%= ex.name %></strong>
          <% if ex.sets_prescription.present? || ex.reps_prescription.present? %>
            — <%= [ex.sets_prescription, ex.reps_prescription].compact.join(" · ") %>
          <% end %>
        </li>
      <% end %>
    </ol>
    <div class="mt-auto d-grid gap-2">
      <%= link_to "Log today", new_daily_log_strength_session_path(today, workout_plan_id: plan.id), class: "btn btn-primary" %>
      <%= link_to "View details", workout_plan_path(plan), class: "btn btn-outline-secondary btn-sm" %>
    </div>
  </div>
</div>
