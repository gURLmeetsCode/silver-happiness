<h1 class="h3 mb-4">Add a product</h1>
<p class="text-muted">Save foods you eat often — use them to auto-calculate meals.</p>

<%= form_with model: @product, class: "row g-3" do |f| %>
  <% if @product.errors.any? %>
    <div class="col-12 alert alert-danger"><%= @product.errors.full_messages.to_sentence %></div>
  <% end %>

  <%= hidden_field_tag :return_to, params[:return_to] %>

  <div class="col-md-8">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: "form-control", required: true %>
  </div>
  <div class="col-md-4">
    <%= f.label :brand, class: "form-label" %>
    <%= f.text_field :brand, class: "form-control" %>
  </div>

  <div class="col-12"><p class="small text-muted mb-0">Per 100 g</p></div>
  <div class="col-md-3">
    <%= f.label :calories_per_100g, "Calories", class: "form-label" %>
    <%= f.number_field :calories_per_100g, step: 0.1, class: "form-control", required: true %>
  </div>
  <div class="col-md-3">
    <%= f.label :protein_per_100g, "Protein (g)", class: "form-label" %>
    <%= f.number_field :protein_per_100g, step: 0.1, class: "form-control", required: true %>
  </div>
  <div class="col-md-3">
    <%= f.label :carbs_per_100g, "Carbs (g)", class: "form-label" %>
    <%= f.number_field :carbs_per_100g, step: 0.1, class: "form-control" %>
  </div>
  <div class="col-md-3">
    <%= f.label :fat_per_100g, "Fat (g)", class: "form-label" %>
    <%= f.number_field :fat_per_100g, step: 0.1, class: "form-control" %>
  </div>

  <div class="col-md-4">
    <%= f.label :default_serving_g, "Typical serving (g)", class: "form-label" %>
    <%= f.number_field :default_serving_g, step: 0.1, class: "form-control" %>
  </div>
  <div class="col-md-8">
    <%= f.label :serving_label, class: "form-label" %>
    <%= f.text_field :serving_label, class: "form-control", placeholder: "e.g. 1 scoop, 1 pavé" %>
  </div>

  <div class="col-12 d-flex gap-2">
    <%= f.submit "Save product", class: "btn btn-primary" %>
    <%= link_to "Cancel", params[:return_to].presence || root_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
