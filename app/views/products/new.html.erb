<div data-controller="barcode-scanner"
     data-barcode-scanner-lookup-url-value="<%= lookup_barcode_products_path %>">
  <h1 class="h3 mb-2">Add a product</h1>
  <p class="text-muted mb-4">Scan a barcode or enter nutrition from the label (French packages work well via Open Food Facts).</p>

  <div class="card stat-card mb-4">
    <div class="card-body">
      <h2 class="h6 mb-3">Scan barcode</h2>
      <p class="small text-muted">Uses your phone camera. Packaged foods in France are looked up from Open Food Facts — values are per 100 g from the label.</p>

      <div class="d-flex flex-wrap gap-2 mb-3">
        <button type="button" class="btn btn-primary" data-action="barcode-scanner#startScan">Open scanner</button>
        <button type="button" class="btn btn-outline-secondary" data-action="barcode-scanner#stopScan">Stop</button>
      </div>

      <div id="barcode-reader" class="rounded overflow-hidden mb-3 d-none" data-barcode-scanner-target="reader" style="max-width: 100%; min-height: 240px;"></div>
      <p class="small text-primary mb-3" data-barcode-scanner-target="status"></p>

      <div class="row g-2 align-items-end">
        <div class="col-sm-8">
          <label class="form-label small mb-1">Or type barcode (EAN)</label>
          <input type="text" inputmode="numeric" pattern="[0-9]*" class="form-control" placeholder="e.g. 3259011034000" data-barcode-scanner-target="manualBarcode">
        </div>
        <div class="col-sm-4">
          <button type="button" class="btn btn-outline-primary w-100" data-action="barcode-scanner#lookupManual">Look up</button>
        </div>
      </div>
    </div>
  </div>

  <%= form_with model: @product, class: "row g-3", data: { barcode_scanner_target: "form" } do |f| %>
    <% if @product.errors.any? %>
      <div class="col-12 alert alert-danger"><%= @product.errors.full_messages.to_sentence %></div>
    <% end %>

    <%= hidden_field_tag :return_to, params[:return_to] %>

    <div class="col-md-8">
      <%= f.label :name, class: "form-label" %>
      <%= f.text_field :name, class: "form-control", required: true, data: { barcode_scanner_target: "name" } %>
    </div>
    <div class="col-md-4">
      <%= f.label :brand, class: "form-label" %>
      <%= f.text_field :brand, class: "form-control", data: { barcode_scanner_target: "brand" } %>
    </div>
    <div class="col-md-4">
      <%= f.label :barcode, "Barcode (EAN)", class: "form-label" %>
      <%= f.text_field :barcode, class: "form-control", data: { barcode_scanner_target: "barcode" } %>
    </div>

    <div class="col-12"><p class="small text-muted mb-0">Per 100 g — as on « pour 100 g » on French labels</p></div>
    <div class="col-md-3">
      <%= f.label :calories_per_100g, "Calories (kcal)", class: "form-label" %>
      <%= f.number_field :calories_per_100g, step: 0.1, class: "form-control", required: true, data: { barcode_scanner_target: "calories" } %>
    </div>
    <div class="col-md-3">
      <%= f.label :protein_per_100g, "Protein (g)", class: "form-label" %>
      <%= f.number_field :protein_per_100g, step: 0.1, class: "form-control", required: true, data: { barcode_scanner_target: "protein" } %>
    </div>
    <div class="col-md-3">
      <%= f.label :carbs_per_100g, "Carbs (g)", class: "form-label" %>
      <%= f.number_field :carbs_per_100g, step: 0.1, class: "form-control", data: { barcode_scanner_target: "carbs" } %>
    </div>
    <div class="col-md-3">
      <%= f.label :fat_per_100g, "Fat (g)", class: "form-label" %>
      <%= f.number_field :fat_per_100g, step: 0.1, class: "form-control", data: { barcode_scanner_target: "fat" } %>
    </div>

    <div class="col-md-4">
      <%= f.label :default_serving_g, "Typical serving (g)", class: "form-label" %>
      <%= f.number_field :default_serving_g, step: 0.1, class: "form-control", data: { barcode_scanner_target: "servingG" } %>
    </div>
    <div class="col-md-8">
      <%= f.label :serving_label, class: "form-label" %>
      <%= f.text_field :serving_label, class: "form-control", placeholder: "e.g. 1 pavé, 1 pot", data: { barcode_scanner_target: "servingLabel" } %>
    </div>
    <div class="col-12">
      <%= f.label :notes, class: "form-label" %>
      <%= f.text_field :notes, class: "form-control", data: { barcode_scanner_target: "notes" } %>
    </div>
    <div class="col-12">
      <div class="form-check">
        <%= f.check_box :quick_log, class: "form-check-input" %>
        <%= f.label :quick_log, "Show on Quick add drink / snack (one tap from home & daily log)", class: "form-check-label" %>
      </div>
    </div>

    <div class="col-12 d-flex gap-2">
      <%= f.submit "Save product", class: "btn btn-primary" %>
      <%= link_to "Cancel", params[:return_to].presence || root_path, class: "btn btn-outline-secondary" %>
    </div>
  <% end %>
</div>
